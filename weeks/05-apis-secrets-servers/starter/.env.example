# .env.example: a TEMPLATE for your settings. It is committed to git, so it must
# only ever contain placeholders, never a real key.
#
# 1. Copy it:            cp .env.example .env
# 2. Put your real key in .env (never in a chat, an issue or a commit).
#    .env is listed in .gitignore, so git will not commit it.
# 3. Run `npm run models` and copy one model ID into LLM_MODEL.
# 4. Restart `npm run dev` after every change to .env.
#
# To switch provider, change all three LLM_ lines. Base URLs are also in TOOLS.md.

# --- Primary: Gemini API (free key from Google AI Studio; 18+) ---
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=paste-your-key-here
LLM_MODEL=paste-a-model-id-from-npm-run-models
# Example only, may be outdated: LLM_MODEL=gemini-flash-lite-latest

# --- Fallback 1: Groq (free key from console.groq.com) ---
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=paste-your-groq-key-here
# LLM_MODEL=paste-a-model-id-from-npm-run-models
# Example only, may be outdated: LLM_MODEL=openai/gpt-oss-20b

# --- Fallback 2: OpenRouter (pick a model ID ending in :free; try `npm run models -- :free`) ---
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=paste-your-openrouter-key-here
# LLM_MODEL=paste-a-model-id-ending-in-free

# --- Local: Ollama on your own computer (not inside a Codespace) ---
# Ollama ignores the key, but the app needs some text there.
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=paste-a-model-name-from-ollama-list
